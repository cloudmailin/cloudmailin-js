{
  "name": "cloudmailin",
  "version": "0.3.2",
  "description": "Official Node.js for the CloudMailin Email API - https://www.cloudmailin.com",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "lint": "eslint ./src",
    "test": "jest",
    "prepare": "rm -rf ./dist && tsc",
    "docs": "rm -rf ./docs && typedoc ./src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudmailin/cloudmailin-js.git"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "cloudmailin",
    "email",
    "mail",
    "smtp",
    "send",
    "headers",
    "nodemailer"
  ],
  "author": "CloudMailin <support@cloudmailin.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cloudmailin/cloudmailin-js/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://www.cloudmailin.com",
  "readme": "https://github.com/cloudmailin/cloudmailin-js#readme",
  "dependencies": {
    "axios": "^1.18.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.19.13",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.2"
  },
  "jest": {
    "verbose": true,
    "preset": "ts-jest"
  },
  "overrides": {
    "minimatch": "^9.0.7",
    "follow-redirects": "^1.16.0"
  }
}
